{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delight0517.github.io/selah-bible-meditation/contracts/selah-cloud-state.schema.json",
  "title": "Selah BlueCloud sync payload (current public web implementation)",
  "description": "Source-derived cross-platform contract for PUT /api/cloud-state/selah, checked against the Selah client at revision 886f6d8. Known record fields are modeled from current writers and normalizers; additional fields remain allowed for compatibility until Mac owner confirmation.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "firstUsedAt",
    "reflections",
    "cards",
    "qtLibrary",
    "selectedQt",
    "passage",
    "customPassage",
    "customPassageActive",
    "meditationFeedback",
    "attendanceDays",
    "meditationPlaces",
    "feedbackPrompt",
    "gptContext",
    "readerPrefs",
    "customFontData",
    "language",
    "readingState",
    "meditationSession",
    "bibleChats",
    "_rev"
  ],
  "properties": {
    "firstUsedAt": {"type": "integer", "minimum": 0, "description": "Unix epoch milliseconds."},
    "reflections": {"type": "array", "items": {"$ref": "#/$defs/reflection"}},
    "cards": {"type": "array", "items": {"$ref": "#/$defs/quizCard"}},
    "qtLibrary": {"type": "array", "items": {"$ref": "#/$defs/qtLink"}},
    "selectedQt": {"type": "string"},
    "passage": {"type": "integer", "minimum": 0},
    "customPassage": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {"ref": {"type": "string", "maxLength": 120}, "text": {"type": "string", "maxLength": 10000}}
    },
    "customPassageActive": {"type": "boolean"},
    "meditationFeedback": {"type": "array", "items": {"$ref": "#/$defs/meditationFeedback"}},
    "attendanceDays": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "meditationPlaces": {"type": "array", "items": {"$ref": "#/$defs/meditationPlace"}},
    "feedbackPrompt": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "skips": {"type": "integer", "minimum": 0},
        "nextAskAt": {"type": "integer", "minimum": 0},
        "lastPromptDay": {"type": "string"},
        "updatedAt": {"type": "integer", "minimum": 0}
      }
    },
    "gptContext": {"type": "string"},
    "readerPrefs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "desktop": {"$ref": "#/$defs/readerPreference"},
        "mobile": {"$ref": "#/$defs/readerPreference"}
      },
      "description": "Separate reader preferences selected by viewport width (mobile at max-width 760px, desktop otherwise)."
    },
    "customFontData": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "language": {"type": "string"},
        "type": {"type": "string"},
        "data": {"type": "string", "contentEncoding": "base64"},
        "deleted": {"type": "boolean"},
        "updatedAt": {"type": "integer", "minimum": 0}
      }
    },
    "language": {"type": "string"},
    "readingState": {
      "type": ["object", "null"], "additionalProperties": true,
      "properties": {
        "passage": {"type": "integer", "minimum": 0}, "book": {"type": "string"}, "chapter": {"type": "integer", "minimum": 1},
        "customPassageActive": {"type": "boolean"}, "scrollRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "verseAnchor": {"type": "integer", "minimum": 0}, "verseOffset": {"type": "number", "minimum": 0, "maximum": 1},
        "updatedAt": {"type": "integer", "minimum": 0}
      }
    },
    "meditationSession": {
      "type": ["object", "null"], "additionalProperties": true,
      "properties": {
        "id": {"type": "string"}, "status": {"enum": ["running", "paused", "completed", "ended"]},
        "durationMs": {"type": "integer", "minimum": 0}, "remainingMs": {"type": "integer", "minimum": 0},
        "endsAt": {"type": "integer", "minimum": 0}, "ref": {"type": "string"}, "updatedAt": {"type": "integer", "minimum": 0}
      }
    },
    "bibleChats": {"type": "array", "items": {"$ref": "#/$defs/bibleChat"}},
    "_rev": {"type": "integer", "minimum": 0, "description": "Server revision used for optimistic concurrency; the client retries HTTP 409 up to three attempts."}
  },
  "$defs": {
    "readerPreference": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "font": {"type": "string"},
        "size": {"type": "integer", "minimum": 18, "maximum": 32},
        "fontLanguage": {"type": "string"},
        "fontsByLanguage": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "reflection": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "id": {"type": "string"}, "ref": {"type": "string"}, "date": {"type": "string"},
        "text": {"type": "string"}, "prayer": {"type": "string"},
        "tags": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 24}},
        "media": {"type": ["object", "null"], "additionalProperties": true, "properties": {"title": {"type": "string"}, "url": {"type": "string"}}},
        "createdAt": {"type": "integer", "minimum": 0}, "updatedAt": {"type": "integer", "minimum": 0}
      }
    },
    "quizCard": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "id": {"type": "string"}, "q": {"type": "string"}, "a": {"type": "string"},
        "due": {"type": "string"}, "interval": {"type": "integer", "minimum": 0}, "updatedAt": {"type": "integer", "minimum": 0}
      }
    },
    "qtLink": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string", "format": "uri"},
        "sourceId": {"type": "string"}, "createdAt": {"type": "integer", "minimum": 0}, "updatedAt": {"type": "integer", "minimum": 0}
      }
    },
    "meditationFeedback": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "id": {"type": "string"}, "date": {"type": "string"}, "ref": {"type": "string"}, "rating": {"type": "string"},
        "good": {"type": "string", "maxLength": 2000}, "improve": {"type": "string", "maxLength": 2000}, "situation": {"type": "string", "maxLength": 2000},
        "reflection": {"type": ["object", "null"], "additionalProperties": true, "properties": {"text": {"type": "string"}, "prayer": {"type": "string"}}, "default": null},
        "analysis": {"oneOf": [{"$ref": "#/$defs/experienceAnalysis"}, {"type": "null"}]},
        "createdAt": {"type": "integer", "minimum": 0}, "updatedAt": {"type": "integer", "minimum": 0}
      }
    },
    "experienceAnalysis": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "focusPlaces": {"type": "array", "items": {"$ref": "#/$defs/experiencePlace"}},
        "avoidPlaces": {"type": "array", "items": {"$ref": "#/$defs/experiencePlace"}},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/experienceCondition"}}, "summary": {"type": "string", "maxLength": 400}
      }
    },
    "experiencePlace": {
      "type": "object", "additionalProperties": true,
      "properties": {"place": {"type": "string"}, "conditions": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string"}}
    },
    "experienceCondition": {
      "type": "object", "additionalProperties": true,
      "properties": {"condition": {"type": "string"}, "effect": {"type": "string"}}
    },
    "meditationPlace": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "id": {"type": "string"}, "type": {"enum": ["focus", "avoid", "condition"]},
        "place": {"type": "string", "maxLength": 120}, "condition": {"type": "string", "maxLength": 120},
        "conditions": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 120}},
        "effect": {"type": "string", "maxLength": 240}, "reason": {"type": "string", "maxLength": 240},
        "feedbackId": {"type": "string"}, "date": {"type": "string"}, "createdAt": {"type": "integer", "minimum": 0}
      }
    },
    "bibleChat": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "maxLength": 80}, "ref": {"type": "string", "maxLength": 120}, "quote": {"type": "string", "maxLength": 1500},
        "createdAt": {"type": "integer", "minimum": 0}, "updatedAt": {"type": "integer", "minimum": 0}, "expiresAt": {"type": "integer", "minimum": 0},
        "status": {"enum": ["active", "ended"]}, "turns": {"type": "array", "items": {"$ref": "#/$defs/bibleChatTurn"}}
      }
    },
    "bibleChatTurn": {
      "type": "object", "additionalProperties": true,
      "properties": {"role": {"enum": ["user", "assistant"]}, "text": {"type": "string", "maxLength": 1200}, "createdAt": {"type": "integer", "minimum": 0}}
    }
  },
  "x-selah-sync-semantics": {
    "endpoint": "/api/cloud-state/selah",
    "localStateKey": "selah.v1",
    "authTokenKey": "selah.bluecloud.token",
    "authTokenIncluded": false,
    "localOnlyStateFields": ["owner", "draft"],
    "ownerFieldIncludedInPayload": false,
    "draftIncludedInPayload": false,
    "contractVersionField": null,
    "unknownFields": "The client forwards unknown top-level properties from the signed-in account GET response and preserves extension properties in modeled nested objects while normalizing known fields. Current Brainwire origin/main source stores the full incoming document; authenticated live round trip remains unverified.",
    "existingUnknownFieldParityGap": "No authenticated live GET/PUT/GET verification has been performed. Current Brainwire origin/main handler stores the full incoming document.",
    "ownerChange": "The local owner value gates account merges but is not sent; account-scoped state is reset before the newly signed-in account state is applied.",
    "recordCollectionsMerge": "reflections, cards, qtLibrary, bibleChats, meditationFeedback, and meditationPlaces merge by id; the greater updatedAt wins and local data wins ties.",
    "feedbackPromptMerge": "The greater updatedAt wins; local data wins ties.",
    "attendanceDaysMerge": "Set union, then sort.",
    "readingStateAndMeditationSession": "Merged by source-specific logic; do not replace with generic last-write-wins.",
    "localAnonymousData": "Remains in the current browser app storage and is not automatically shared with another device."
  }
}
