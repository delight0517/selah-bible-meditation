{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delight0517.github.io/selah-bible-meditation/contracts/selah-cloud-state.schema.json",
  "title": "Selah BlueCloud sync payload (current public web implementation)",
  "description": "Source-derived cross-platform contract for PUT /api/cloud-state/selah. Existing record fields were checked against revision 831225c (2026-10-02); computer-reading fields were checked against the Mac Selah checkout and Windows Pomodoro consumer on 2026-10-02. Additional fields remain allowed for forward compatibility.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "firstUsedAt",
    "reflections",
    "cards",
    "qtLibrary",
    "selectedQt",
    "passage",
    "customPassage",
    "customPassageActive",
    "meditationFeedback",
    "attendanceDays",
    "meditationPlaces",
    "feedbackPrompt",
    "gptContext",
    "readerPrefs",
    "customFontData",
    "language",
    "readingState",
    "meditationSession",
    "bibleChats",
    "_rev"
  ],
  "properties": {
    "firstUsedAt": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix epoch milliseconds."
    },
    "reflections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reflection"
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quizCard"
      }
    },
    "qtLibrary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qtLink"
      }
    },
    "selectedQt": {
      "type": "string"
    },
    "passage": {
      "type": "integer",
      "minimum": 0
    },
    "customPassage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "customPassageActive": {
      "type": "boolean"
    },
    "meditationFeedback": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meditationFeedback"
      }
    },
    "attendanceDays": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "meditationPlaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meditationPlace"
      }
    },
    "feedbackPrompt": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "skips": {
          "type": "integer",
          "minimum": 0
        },
        "nextAskAt": {
          "type": "integer",
          "minimum": 0
        },
        "lastPromptDay": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gptContext": {
      "type": "string"
    },
    "readerPrefs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "desktop": {
          "$ref": "#/$defs/readerPreference"
        },
        "mobile": {
          "$ref": "#/$defs/readerPreference"
        },
        "highlightColor": {
          "type": "string",
          "enum": [
            "yellow",
            "green",
            "blue",
            "pink",
            "purple",
            "orange"
          ],
          "description": "Last selected private Scripture highlight color for this account."
        }
      },
      "description": "Separate reader preferences selected by viewport width (mobile at max-width 760px, desktop otherwise), plus the account's preferred Scripture highlight color."
    },
    "customFontData": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "deleted": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "language": {
      "type": "string"
    },
    "bibleContentLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "updatedAt"
      ],
      "properties": {
        "code": {
          "enum": [
            "ko",
            "en",
            "ja",
            "zh-CN",
            "zh-TW"
          ]
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Optional explicit Bible text-language choice, separate from the UI locale in language. Absent means follow the UI locale. Greater updatedAt wins; equal timestamps resolve deterministically to the lexicographically smaller code so clients converge. Downloaded translation IDs and chapter cache are per browser profile."
    },
    "computerReadingRequest": {
      "oneOf": [
        {
          "$ref": "#/$defs/computerReadingRequest"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional cross-device command. It carries only request/session IDs, action, target platform, and creation time; Scripture and reflection text are not included."
    },
    "computerReadingResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/computerReadingResult"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional result for the current computerReadingRequest. Consumers must match result.id to request.id before displaying it."
    },
    "computerReadingSession": {
      "oneOf": [
        {
          "$ref": "#/$defs/computerReadingSession"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional shared focus-reading session. Visible readers heartbeat about every 20 seconds; paused sessions remain resumable for seven minutes."
    },
    "readingState": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "passage": {
          "type": "integer",
          "minimum": 0
        },
        "book": {
          "type": "string"
        },
        "chapter": {
          "type": "integer",
          "minimum": 1
        },
        "customPassageActive": {
          "type": "boolean"
        },
        "scrollRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verseAnchor": {
          "type": "integer",
          "minimum": 0
        },
        "verseOffset": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "meditationSession": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "paused",
            "completed",
            "ended"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "remainingMs": {
          "type": "integer",
          "minimum": 0
        },
        "endsAt": {
          "type": "integer",
          "minimum": 0
        },
        "ref": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bibleChats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bibleChat"
      }
    },
    "_rev": {
      "type": "integer",
      "minimum": 0,
      "description": "Server revision used for optimistic concurrency; the client retries HTTP 409 up to three attempts."
    },
    "_selahSync": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "counter",
        "fields",
        "records",
        "deleted",
        "recovery"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "counter": {
          "type": "integer",
          "minimum": 0
        },
        "fields": {
          "type": "object"
        },
        "records": {
          "type": "object"
        },
        "deleted": {
          "type": "object"
        },
        "recovery": {
          "type": "object"
        }
      },
      "description": "Shared data contract v1: hybrid clocks, per-record deletions and recoverable losing record versions. No account credentials."
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "prayer": {
            "type": "string"
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "description": "Account-synced drafts per installation and writer. The active local draft is retained separately."
    },
    "appearance": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Shared theme, UI font and custom palettes. Stored values are selected through _selahSync.fields.appearance."
    },
    "readerMarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ref",
          "kind",
          "locale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "bookmark",
              "highlight"
            ]
          },
          "locale": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "enum": [
              "yellow",
              "green",
              "blue",
              "pink",
              "purple",
              "orange"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "description": "UTF-16 offset within the selected verse text; omitted on imported legacy whole-verse highlights."
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "description": "Exclusive UTF-16 offset within the selected verse text."
          }
        },
        "additionalProperties": true
      }
    },
    "legacyReaderArchives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceKey",
          "value"
        ],
        "additionalProperties": true
      },
      "description": "Original standalone reader data retained during additive migration."
    },
    "togetherReads": {
      "type": "array",
      "description": "Private account-scoped history for users who joined a shared reading room; raw room IDs and invite tokens are never stored.",
      "items": {
        "$ref": "#/$defs/togetherRead"
      }
    },
    "bibleAudioLinks": {
      "type": "array",
      "description": "User-owned Bible reading audio sites, YouTube channels, videos, and playlists saved by Bible translation.",
      "items": {
        "$ref": "#/$defs/bibleAudioLink"
      }
    },
    "bibleAudioDefaults": {
      "type": "array",
      "description": "One preferred Bible audio source per Bible translation.",
      "items": {
        "$ref": "#/$defs/bibleAudioDefault"
      }
    }
  },
  "$defs": {
    "computerReadingRequest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "action",
        "targetPlatform",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "const": "open-reading"
        },
        "targetPlatform": {
          "enum": [
            "macOS",
            "windows"
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix epoch milliseconds; Windows consumers expire requests after two minutes."
        }
      }
    },
    "computerReadingResult": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "status",
        "completedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "opened",
            "expired",
            "rejected"
          ]
        },
        "reason": {
          "type": "string"
        },
        "openedWith": {
          "type": [
            "string",
            "null"
          ]
        },
        "completedAt": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix epoch milliseconds."
        }
      }
    },
    "computerReadingSession": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "status",
        "ref",
        "updatedAt",
        "lastSeenAt",
        "resumeGraceUntil"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "running",
            "paused"
          ]
        },
        "ref": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "lastSeenAt": {
          "type": "integer",
          "minimum": 0
        },
        "resumeGraceUntil": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix epoch milliseconds; paused sessions remain active until this time."
        }
      }
    },
    "readerPreference": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "font": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 18,
          "maximum": 32
        },
        "fontLanguage": {
          "type": "string"
        },
        "fontsByLanguage": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "reflection": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "prayer": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 24
          }
        },
        "media": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "properties": {
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          }
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "quizCard": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "q": {
          "type": "string"
        },
        "a": {
          "type": "string"
        },
        "due": {
          "type": "string"
        },
        "interval": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "qtLink": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sourceId": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "meditationFeedback": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "rating": {
          "type": "string"
        },
        "good": {
          "type": "string",
          "maxLength": 2000
        },
        "improve": {
          "type": "string",
          "maxLength": 2000
        },
        "situation": {
          "type": "string",
          "maxLength": 2000
        },
        "reflection": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "properties": {
            "text": {
              "type": "string"
            },
            "prayer": {
              "type": "string"
            }
          },
          "default": null
        },
        "analysis": {
          "oneOf": [
            {
              "$ref": "#/$defs/experienceAnalysis"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "experienceAnalysis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "focusPlaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/experiencePlace"
          }
        },
        "avoidPlaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/experiencePlace"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/experienceCondition"
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "experiencePlace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "place": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "experienceCondition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "condition": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        }
      }
    },
    "meditationPlace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "focus",
            "avoid",
            "condition"
          ]
        },
        "place": {
          "type": "string",
          "maxLength": 120
        },
        "condition": {
          "type": "string",
          "maxLength": 120
        },
        "conditions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "effect": {
          "type": "string",
          "maxLength": 240
        },
        "reason": {
          "type": "string",
          "maxLength": 240
        },
        "feedbackId": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bibleChat": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        },
        "ref": {
          "type": "string",
          "maxLength": 120
        },
        "quote": {
          "type": "string",
          "maxLength": 1500
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "active",
            "ended"
          ]
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bibleChatTurn"
          }
        }
      }
    },
    "bibleChatTurn": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 1200
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "togetherRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "passage",
        "participantCount",
        "startedAt",
        "updatedAt",
        "friendName"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$",
          "description": "Truncated SHA-256 digest of an ephemeral room ID."
        },
        "passage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "book",
            "chapter",
            "translation",
            "language"
          ],
          "properties": {
            "book": {
              "type": "string",
              "maxLength": 16
            },
            "chapter": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "translation": {
              "type": "string",
              "maxLength": 80
            },
            "language": {
              "type": "string",
              "maxLength": 16
            }
          }
        },
        "participantCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "startedAt": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "endedAt": {
          "type": "integer",
          "minimum": 0
        },
        "friendName": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "bibleAudioLink": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "translationId": {
          "type": "string",
          "maxLength": 100
        },
        "translationName": {
          "type": "string",
          "maxLength": 120
        },
        "language": {
          "type": "string",
          "maxLength": 16
        },
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "mediaType": {
          "enum": [
            "video",
            "playlist",
            "channel",
            "site"
          ]
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "verseCues": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/bibleAudioVerseCue"
          }
        }
      }
    },
    "bibleAudioDefault": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "translationId": {
          "type": "string",
          "maxLength": 100
        },
        "sourceId": {
          "type": "string",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bibleAudioVerseCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookId",
        "chapter",
        "verse",
